# ── New project / new machine ───────────────────────────────────────────────
# 1. Copy this file to `.env` and replace placeholders (never commit real `.env`).
# 2. Supabase: Dashboard → Settings → API (URL + anon + service_role).
# 3. CLI: `supabase login` → `supabase link --project-ref <subdomain>` (subdomain = hostname of *.supabase.co).
# 4. Ship DB + Edge: from this folder run `npm run supabase:all` (migrations, Edge secrets, functions, Vault cron).
# 5. Store name, SEO, footer, support email: Admin panel → Settings (`store_settings` in DB), not public env.
# ───────────────────────────────────────────────────────────────────────────

# --- Supabase (browser + server) ---
NEXT_PUBLIC_SUPABASE_URL= # https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY= # anon public key (same API screen)
SUPABASE_SERVICE_ROLE_KEY= # service_role — server, scripts, Edge deploy only; never expose to clients

# --- On-demand ISR (admin / automation → POST /api/revalidate) ---
# Optional: shared secret; server-side callers can send header x-revalidate-secret.
REVALIDATE_SECRET=
# Browser calls from the admin app (different origin): comma-separated exact origins, no trailing slash.
# Example: https://admin.example.com,http://localhost:5173
REVALIDATE_CORS_ORIGINS=

# --- Site URL (no trailing slash) ---
# Use https:// for production (canonical host for sitemap, OG, proxy redirects). Pick ONE apex or www and match Vercel “Production” domain.
# If you mistakenly set http://, production builds still rewrite public hosts to https:// in getPublicSiteUrl().
NEXT_PUBLIC_SITE_URL= # e.g. https://outflint.pk (canonical) — avoid mixing www here unless www is your canonical host
NEXT_PUBLIC_DEV_SITE_ORIGIN= # Dev fallback when SITE_URL unset; usually http://localhost:3000

# --- Optional public defaults (non-secret) ---
NEXT_PUBLIC_DEFAULT_SUPPORT_EMAIL= # Footer/support stub when catalog has no DB row; align with real support in Admin
NEXT_PUBLIC_FAVICON_URL= # Optional favicon URL or root path (e.g. https://cdn.example.com/favicon.png or /favicon.png)

NEXT_PUBLIC_INSTAGRAM_URL= # Full URL or empty = hide icon
NEXT_PUBLIC_FACEBOOK_URL= # Full URL or empty = hide icon

# Optional GA4 fallback (G-…) when Admin → SEO → Analytics “Google Analytics 4” is empty; prefer DB.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# --- Meta Conversions API (server-only; GTM should own browser Pixel) ---
META_PIXEL_ID=2830556603968775
META_ACCESS_TOKEN= # Meta Events Manager → Conversions API access token; never expose to clients
META_GRAPH_API_VERSION= # Optional, defaults to v21.0
# Optional override; empty = NEXT_PUBLIC_SUPABASE_URL/functions/v1/meta-capi
NEXT_PUBLIC_META_CAPI_EDGE_URL=

# --- Google One Tap (optional) ---
NEXT_PUBLIC_GOOGLE_ONE_TAP= # 1 or true to enable (needs CLIENT_ID + origins in Google Cloud)
NEXT_PUBLIC_GOOGLE_CLIENT_ID= # Web client ID (OAuth credentials)
NEXT_PUBLIC_GOOGLE_ONE_TAP_ALLOWED_ORIGINS= # Comma-separated exact origins (must match Google Cloud OAuth “Authorized JavaScript origins”), e.g. https://outflint.pk,https://www.outflint.pk,http://localhost:3000
NEXT_PUBLIC_GOOGLE_ONE_TAP_DEV_ALL_ORIGINS= # Dev only: 1/true if testing from LAN origins not listed above

# --- Resend (transactional email) ---
RESEND_API_KEY= # re_… ; empty = skip send where Resend is used
RESEND_FROM= # Verified sender, e.g. "Brand <mail@your-domain.com>"
RESEND_DEFAULT_FROM= # Fallback when RESEND_FROM empty (e.g. Resend onboarding address during setup)
RESEND_CONTACT_TO= # Destination for /api/contact form

# --- Next.js dev / images ---
NEXT_EXTRA_DEV_ORIGINS= # LAN IPs or hostnames for HMR (no https://), comma-separated; empty if unused
NEXT_PUBLIC_CDN_IMAGE_HOST= # Optional extra image hostname for next/image; empty = SITE_URL host + Supabase + Unsplash
NEXT_PUBLIC_CDN_IMAGE_PATHNAME= # Glob when HOST set, e.g. /**
# Comma-separated hostnames only (no https://), e.g. img.vendor.com,cdn.example.com — for next/image on grids + PDP
NEXT_PUBLIC_EXTRA_IMAGE_HOSTS=

# --- Ask Store AI (OpenRouter) ---
OPENROUTER_API_KEY= # Empty = chat API disabled
OPENROUTER_MODEL= # e.g. openai/gpt-4o-mini
OPENROUTER_DEFAULT_MODEL= # Used if OPENROUTER_MODEL empty
OPENROUTER_API_URL= # Default https://openrouter.ai/api/v1/chat/completions
OPENROUTER_FETCH_TIMEOUT_MS= # Milliseconds (e.g. 90000)
OPENROUTER_HTTP_REFERER= # Optional; often same as public site
OPENROUTER_APP_TITLE= # Optional header sent to OpenRouter
NEXT_PUBLIC_ASK_STORE_MODEL_LABEL= # Label under chat widget (must be NEXT_PUBLIC_)

# --- Restock Edge + pg_cron (same values pushed by `npm run supabase:all`) ---
CRON_SECRET= # Long random secret; Bearer for cron + Edge `restock-notifications`; auto-written if missing on first deploy
PUBLIC_SITE_URL= # Storefront URL for product links in restock emails — same origin as NEXT_PUBLIC_SITE_URL (e.g. https://outflint.pk)
EDGE_PUBLIC_SITE_URL= # Edge functions / cron; match PUBLIC_SITE_URL in production (e.g. https://outflint.pk)
EDGE_DEV_SITE_ORIGIN= # Last-resort URL in Edge when no public site vars set; default http://localhost:3000
