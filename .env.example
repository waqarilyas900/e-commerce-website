# Copy to Vercel → Settings → Environment Variables (Production / Preview).
# Local: copy to `.env` — never commit real secrets.

NEXT_PUBLIC_STORE_VERTICAL=electronics

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server-only (API routes / scripts) — optional unless you use service-role routes
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Canonical site URL for emails and absolute links (set to your Vercel URL in production)
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# Optional: Google One Tap
NEXT_PUBLIC_GOOGLE_ONE_TAP=0
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Email (Resend) — optional for contact / order emails
RESEND_API_KEY=
RESEND_FROM=
RESEND_CONTACT_TO=

# Cron: /api/cron/restock-notifications
CRON_SECRET=
