# Copy to `.env` and fill in values. Never commit real secrets.

# OpenRouter — server-only; powers `POST /api/store-ai/chat` (“Ask store AI” in the UI)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional: per-request cap in ms (15000–120000); default 90000
# OPENROUTER_FETCH_TIMEOUT_MS=90000
# Optional: OpenRouter leaderboard attribution
# OPENROUTER_HTTP_REFERER=https://your-site.example
# OPENROUTER_APP_TITLE=Your store name

# Optional: label shown under the chat (e.g. match OPENROUTER_MODEL); must start with NEXT_PUBLIC_ to appear in the browser
# NEXT_PUBLIC_ASK_STORE_MODEL_LABEL=OpenAI GPT-4o mini

# If Ask store AI fails with connection/DNS errors on Windows dev, try: NODE_OPTIONS=--dns-result-order=ipv4first

# Restock “back in stock” emails — Supabase Edge Function `restock-notifications` (not Vercel cron).
# Deploy + DB Vault + Edge secrets: npm run cron:restock:deploy
# Multi-env (staging / uat / prod): create `.env.staging` | `.env.uat` | `.env.production` (or `.env.prod`), then:
#   npm run supabase:deploy -- staging
#   (applies migrations incl. pg_cron daily UTC; syncs CRON_SECRET to Vault edge_cron_shared_secret + Edge secrets)
# Manual run: npm run cron:restock
# CRON_SECRET=…  (shared for Edge auth + pg_cron; rotate: npm run cron:restock:deploy -- --rotate-cron)
# NEXT_PUBLIC_SITE_URL=https://your-store.example  (product links; pushed as PUBLIC_SITE_URL to the function)

# Supabase (storefront) — also set NEXT_PUBLIC_SUPABASE_URL + NEXT_PUBLIC_SUPABASE_ANON_KEY in your real `.env`.
# Server-only: contact form optional image uploads go to Storage bucket `e-commerce-store` under `contact-inquiries/…`.
# Without this key, the contact form still works for text-only messages; with images attached, uploads require the service role.
# SUPABASE_SERVICE_ROLE_KEY=
