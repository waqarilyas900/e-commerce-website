# Copy to .env and fill in. Never commit .env.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Restock cron: same value in Vercel + Authorization: Bearer for /api/cron/restock-notifications
CRON_SECRET=

# Resend (restock + transactional). Without a verified domain, Resend only delivers to your account email.
RESEND_API_KEY=
RESEND_FROM=
