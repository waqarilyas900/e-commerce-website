# Copy to `.env`. Keys are used by Next, `scripts/*.mjs`, and/or Edge `restock-notifications`. Fill secrets per deploy.
# Full Supabase pipeline (migrations + all Edge functions + Edge secrets + Vault cron): `npm run supabase:all` (after `supabase login` + `supabase link`).

NEXT_PUBLIC_SUPABASE_URL= # Supabase → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY= # Same screen → anon (public) key
SUPABASE_SERVICE_ROLE_KEY= # service_role key (server + scripts only; never ship to browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000 # Public https origin, no trailing slash; prod: your domain
NEXT_PUBLIC_DEV_SITE_ORIGIN=http://localhost:3000 # Last resort before localhost if NEXT_PUBLIC_SITE_URL unset
NEXT_PUBLIC_DEFAULT_SUPPORT_EMAIL= # Stub catalog support when DB empty; often same inbox as RESEND_CONTACT_TO
NEXT_PUBLIC_INSTAGRAM_URL= # Full profile URL; empty hides Instagram icon
NEXT_PUBLIC_FACEBOOK_URL= # Full page URL; empty hides Facebook icon
NEXT_PUBLIC_GOOGLE_ONE_TAP= # 1 or true to wrap layout with Google One Tap (needs client id + origins in Google Cloud)
NEXT_PUBLIC_GOOGLE_CLIENT_ID= # OAuth Web client ID (Google Cloud → Credentials)
NEXT_PUBLIC_GOOGLE_ONE_TAP_ALLOWED_ORIGINS= # Comma-separated exact storefront origins allowed for One Tap
NEXT_PUBLIC_GOOGLE_ONE_TAP_DEV_ALL_ORIGINS= # Dev: 1 or true when ALLOWED_ORIGINS empty and host is not localhost; omit in prod builds if you prefer
RESEND_API_KEY= # re_… from Resend; empty skips sending where Resend is used
RESEND_FROM= # Sender, e.g. Brand <mail@your-verified-domain.com>
RESEND_DEFAULT_FROM="Store <onboarding@resend.dev>" # Resend test sender when RESEND_FROM empty (swap after domain verify)
RESEND_CONTACT_TO= # Inbox for /api/contact submissions
NEXT_EXTRA_DEV_ORIGINS=192.168.1.10 # Dev HMR: LAN hostnames/IPs only, comma-separated, no https://
NEXT_PUBLIC_CDN_IMAGE_HOST= # Optional: extra image hostname only (no https). Empty = next.config uses NEXT_PUBLIC_SITE_URL host + Supabase + Unsplash
NEXT_PUBLIC_CDN_IMAGE_PATHNAME="/**" # Only used when CDN_IMAGE_HOST is set; default path glob
OPENROUTER_API_KEY= # Ask Store AI; empty disables chat API
OPENROUTER_MODEL=openai/gpt-4o-mini # Model id for chat
OPENROUTER_DEFAULT_MODEL= # If OPENROUTER_MODEL empty, else hardcoded default in code
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions # Override OpenRouter endpoint
OPENROUTER_FETCH_TIMEOUT_MS=90000 # Request timeout ms (15_000–120_000)
OPENROUTER_HTTP_REFERER= # Optional attribution URL sent to OpenRouter
OPENROUTER_APP_TITLE= # Optional app title header for OpenRouter
NEXT_PUBLIC_ASK_STORE_MODEL_LABEL= # Shown under chat in browser (must be NEXT_PUBLIC_)
CRON_SECRET= # Restock Edge + pg_cron Bearer; scripts + Edge (not Next pages)
PUBLIC_SITE_URL= # Edge restock emails: storefront origin, no trailing slash (e.g. https://www.yoursite.com)
EDGE_PUBLIC_SITE_URL= # Optional third fallback; set same as PUBLIC if Edge secrets omit the first two
EDGE_DEV_SITE_ORIGIN=http://localhost:3000 # Edge last resort if no PUBLIC/NEXT site URL
